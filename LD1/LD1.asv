y = x.^2;

plot (x, y, 'o-r', x, y/3, 'xb')
title('Dvi funkcijos')
xlabel('X-ai')
ylabel('F_1 [-o-]   |   F_2 [-x-]')

N=5

Vektor= N+1:0.5:N+4;

B=[N,N+1,N+2;N+3,N+4,N+5;N+6, N+7,N+8]
a1=B(3,2)
a2=B(2:3;1:2)
a3=B([1 3],[1 3])

